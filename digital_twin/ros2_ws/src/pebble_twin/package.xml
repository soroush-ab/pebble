<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pebble_twin</name>
  <version>0.1.0</version>
  <description>Pebble MCU emulator as a ROS 2 node. Reuses the repo's motion engine, motions.yaml and linkage model; also hosts the original web viewer and /brain WebSocket.</description>
  <maintainer email="sabd821@aucklanduni.ac.nz">COMPSYS 730 Group 5</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>pebble_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
