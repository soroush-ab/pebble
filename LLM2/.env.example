# 复制为 LLM2/.env 并填写（不要提交 .env）/ Copy to LLM2/.env and fill in (never commit .env)
OPENAI_API_KEY=sk-xxxx
LLM2_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # 可选，兼容接口 / optional, compatible endpoint

DEFAULT_NFC_TAG_ID=baymax-demo-01

# Home Assistant（留空则 dry-run，只打印）/ leave empty for dry-run (log only)
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
# HA_ALLOWED_DOMAINS=light,switch,fan,cover,climate,media_player,scene,input_boolean

# HTTP 服务 / HTTP server
SERVER_PORT=8000
PEBBLE_API_TOKEN=change-me
