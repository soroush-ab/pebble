# Pebble MCU - ESP32-S3-N16R8
#
# The checked-in sdkconfig was generated for plain "esp32" with 2 MB flash and
# no PSRAM, which is the wrong chip. Regenerate it:
#
#     rm -f sdkconfig && idf.py set-target esp32s3 && idf.py build
#
# set-target reads this file for the defaults below.

CONFIG_IDF_TARGET="esp32s3"

# N16 = 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# R8 = 8 MB octal-SPI PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# This program does not need PSRAM. If the octal setting is ever wrong for a
# given board, don't let that stop the thing booting.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# 1 ms tick: the sampler asks for 1 kHz, and the default 100 Hz tick would
# quantise vTaskDelayUntil to 10 ms and silently sample at 100 Hz instead.
CONFIG_FREERTOS_HZ=1000

# Console on the native USB-Serial/JTAG port (/dev/ttyACM0) so the test tool can
# be driven by keystrokes, not just the BOOT button.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 16 MB flash: give the app room. The default 1 MB is ~87% full with Wi-Fi in.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
